root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{json,toml,yml,yaml,html,ts,tsx,js,jsx,css,svelte}]
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab
